cx=\"146\" cy=\"122\" r=\"2.6\" fill=\"#FFFFFF\"/><rect x=\"131\" y=\"117.5\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#D8B23A\" stroke=\"#2B3034\" stroke-width=\".8\"/><path d=\"M158 141 Q156 160 176 160 L196 160 Q204 160 204 141\" stroke=\"#2B3034\" stroke-width=\"3\" fill=\"none\"/><path d=\"M178 141 Q183 150 176 156\" stroke=\"#2B3034\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\"/><rect x=\"231\" y=\"139\" width=\"4\" height=\"9\" rx=\"1\" fill=\"#D8B23A\"/><circle cx=\"70\" cy=\"158\" r=\"2.6\" fill=\"#2B3034\"/><circle cx=\"300\" cy=\"138\" r=\"2.6\" fill=\"#2B3034\"/></g><rect x=\"162\" y=\"128\" width=\"10\" height=\"11\" rx=\"2\" fill=\"#FF6A13\"/><rect x=\"214\" y=\"128\" width=\"10\" height=\"11\" rx=\"2\" fill=\"#FF6A13\"/><text x=\"200\" y=\"116\" font-size=\"15\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FF6A13\">2 to 2.5 Nm</text><text x=\"200\" y=\"246\" font-size=\"15\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#17201A\">Clean, then clamp the bases on the dovetail.</text><rect x=\"8\" y=\"258\" width=\"384\" height=\"34\" rx=\"9\" fill=\"#1F3D2B\"/><text x=\"200\" y=\"280\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">Unloaded, bolt out or open. PROVE it first.</text></svg>\n<figcaption><b>1.</b> Ring bases on the dovetail, torqued.</figcaption></figure><figure class=\"step-frame\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\" role=\"img\" aria-label=\"Mounting a scope on the CZ 457, step 2 of 5: Scope in, tops loose. Lay the scope in. Slide it fore and aft.\"><rect x=\"0\" y=\"0\" width=\"400\" height=\"300\" fill=\"#EEF1EA\"/><circle cx=\"26\" cy=\"26\" r=\"14\" fill=\"#FF6A13\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"26\" y=\"31\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">2</text><text x=\"48\" y=\"32\" font-size=\"17\" font-weight=\"bold\" text-anchor=\"start\" fill=\"#1F3D2B\">Scope in, tops loose</text><g transform=\"translate(0 40) scale(1.0)\"><path d=\"M14 108 L128 116 L140 118 L300 120 Q314 121 318 126 L318 132 Q300 138 250 140 L200 141 L162 141 Q150 141 146 150 L136 170 Q132 176 124 174 L120 172 Q126 156 122 146 Q112 142 96 146 L14 168 Z\" fill=\"#9A6B3F\"/><path d=\"M30 116 Q80 120 120 124\" stroke=\"#6E4A2A\" stroke-width=\"1.2\" fill=\"none\"/><rect x=\"7\" y=\"106\" width=\"8\" height=\"64\" rx=\"2\" fill=\"#2B3034\"/><path d=\"M232 105 L390 107 L390 115 L232 117 Z\" fill=\"#4A5156\"/><rect x=\"386\" y=\"106\" width=\"5\" height=\"10\" rx=\"1\" fill=\"#2B3034\"/><rect x=\"255\" y=\"99\" width=\"16\" height=\"7\" rx=\"1.5\" fill=\"#2B3034\"/><rect x=\"266\" y=\"96\" width=\"4\" height=\"4\" fill=\"#2B3034\"/><path d=\"M374 107 L376 97 L388 97 L388 107 Z\" fill=\"#2B3034\"/><rect x=\"140\" y=\"102\" width=\"94\" height=\"17\" rx=\"3\" fill=\"#4A5156\"/><rect x=\"150\" y=\"99\" width=\"78\" height=\"4\" fill=\"#8C959B\"/><rect x=\"160\" y=\"100\" width=\"2\" height=\"2\" fill=\"#2B3034\"/><rect x=\"210\" y=\"100\" width=\"2\" height=\"2\" fill=\"#2B3034\"/><rect x=\"176\" y=\"105\" width=\"36\" height=\"8\" rx=\"1.5\" fill=\"#2B3034\"/><rect x=\"176\" y=\"106\" width=\"36\" height=\"6\" fill=\"#C9CFD3\"/><rect x=\"128\" y=\"104\" width=\"13\" height=\"13\" rx=\"3\" fill=\"#2B3034\"/><rect x=\"121\" y=\"107\" width=\"8\" height=\"7\" rx=\"2\" fill=\"#D8B23A\"/><path d=\"M153 111 L148 131\" stroke=\"#2B3034\" stroke-width=\"5\" stroke-linecap=\"round\"/><circle cx=\"147\" cy=\"136\" r=\"6.5\" fill=\"#2B3034\"/><rect x=\"130\" y=\"119\" width=\"22\" height=\"6\" rx=\"2\" fill=\"#2B3034\"/><circle cx=\"146\" cy=\"122\" r=\"2.6\" fill=\"#FFFFFF\"/><rect x=\"131\" y=\"117.5\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#D8B23A\" stroke=\"#2B3034\" stroke-width=\".8\"/><path d=\"M158 141 Q156 160 176 160 L196 160 Q204 160 204 141\" stroke=\"#2B3034\" stroke-width=\"3\" fill=\"none\"/><path d=\"M178 141 Q183 150 176 156\" stroke=\"#2B3034\" stroke-wi