["<aside class=\"callout why\"><div class=\"callout-t\">Why it matters</div><p>Goose hunters do not track a bird; they track a habit. Fresh droppings on the right patch of a field tell you where to lie down tomorrow.</p></aside><figure class=\"diagram\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\" role=\"img\" aria-label=\"Six tiles of goose sign: droppings, green tubes; tracks, webbed with three toes; feathers and down; clipped grass with the grain gone; calls at dawn and dusk; flocks seen from the road. Fresh sign plus birds seen means the X, a Tip.\">\n  <rect width=\"400\" height=\"300\" fill=\"#fffaf0\"/>\n<text x=\"200\" y=\"24\" font-size=\"17\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">6 signs geese were here</text><rect x=\"15\" y=\"40\" width=\"117\" height=\"115\" rx=\"10\" fill=\"#fff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><g transform=\"translate(59 88) rotate(0) scale(0.9)\"><rect x=\"-18\" y=\"-5\" width=\"36\" height=\"10\" rx=\"5\" fill=\"#6b8e23\"/><rect x=\"12\" y=\"-5\" width=\"6\" height=\"10\" rx=\"3\" fill=\"#f5f5f5\"/><path fill=\"none\" d=\"M-12 -2 L4 -2\" stroke=\"#fff\" stroke-width=\"2\" opacity=\".7\"/></g><g transform=\"translate(89 100) rotate(30) scale(0.8)\"><rect x=\"-18\" y=\"-5\" width=\"36\" height=\"10\" rx=\"5\" fill=\"#6b8e23\"/><rect x=\"12\" y=\"-5\" width=\"6\" height=\"10\" rx=\"3\" fill=\"#f5f5f5\"/><path fill=\"none\" d=\"M-12 -2 L4 -2\" stroke=\"#fff\" stroke-width=\"2\" opacity=\".7\"/></g><g transform=\"translate(77 74) rotate(-20) scale(0.8)\"><rect x=\"-18\" y=\"-5\" width=\"36\" height=\"10\" rx=\"5\" fill=\"#556b2f\"/><rect x=\"12\" y=\"-5\" width=\"6\" height=\"10\" rx=\"3\" fill=\"#f5f5f5\"/><path fill=\"none\" d=\"M-12 -2 L4 -2\" stroke=\"#fff\" stroke-width=\"2\" opacity=\".7\"/></g><text x=\"73\" y=\"128\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Droppings</text><text x=\"73\" y=\"145\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">green tubes</text><rect x=\"142\" y=\"40\" width=\"117\" height=\"115\" rx=\"10\" fill=\"#fff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><g transform=\"translate(200 106) rotate(0) scale(0.9)\"><path d=\"M0 0 L-22 -30 Q-18 -34 -14 -30 L-2 -12 L0 -40 Q4 -44 6 -40 L4 -12 L16 -30 Q20 -34 24 -28 L4 2 Q0 6 -4 2Z\" fill=\"#2f3a2b\" opacity=\".85\"/><path d=\"M-20 -28 Q2 -14 22 -28\" stroke=\"#2f3a2b\" stroke-width=\"2\" fill=\"none\"/></g><text x=\"200\" y=\"128\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Tracks</text><text x=\"200\" y=\"145\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">webbed, 3 toes</text><rect x=\"269\" y=\"40\" width=\"117\" height=\"115\" rx=\"10\" fill=\"#fff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><path d=\"M307 106 Q327 58 345 68 Q333 94 307 106Z\" fill=\"#bdbdbd\"/><line x1=\"307\" y1=\"106\" x2=\"341\" y2=\"72\" stroke=\"#757575\" stroke-width=\"2\"/><circle cx=\"351\" cy=\"100\" r=\"8\" fill=\"#eeeeee\"/><text x=\"327\" y=\"128\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Feathers</text><text x=\"327\" y=\"145\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">and down</text><rect x=\"15\" y=\"165\" width=\"117\" height=\"115\" rx=\"10\" fill=\"#fff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><line x1=\"43\" y1=\"233\" x2=\"43\" y2=\"219\" stroke=\"#7cb342\" stroke-width=\"3\"/><line x1=\"51\" y1=\"233\" x2=\"51\" y2=\"227\" stroke=\"#7cb342\" stroke-width=\"3\"/><line x1=\"59\" y1=\"233\" x2=\"59\" y2=\"219\" stroke=\"#7cb342\" stroke-width=\"3\"/><line x1=\"67\" y1=\"233\" x2=\"67\" y2=\"227\" stroke=\"#7cb342\" stroke-width=\"3\"/><line x1=\"75\" y1=\"233\" x2=\"75\" y2=\"219\" stroke=\"#7cb342\" stroke-width=\"3\"/><line x1=\"83\" y1=\"233\" x2=\"83\" y2=\"227\" stroke=\"#7cb342\" stroke-width=\"3\"/><line x1=\"91\" y1=\"233\" x2=\"91\" y2=\"219\" stroke=\"#7cb342\" stroke-width=\"3\"/><line x1=\"99\" y1=\"233\" x2=\"99\" y2=\"227\" stroke=\"#7cb342\" stroke-width=\"3\"/><text x=\"73\" y=\"253\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Clipped grass</text><text x=\"73\" y=\"270\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">grain gone</text><rect x=\"142\" y=\"165\" width=\"117\" height=\"115\" rx=\"10\" fill=\"#fff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><text x=\"200\" y=\"219\" font-size=\"18\" font-weight=\"bold\" fill=\"#e8590c\" text-anchor=\"middle\">honk!</text><text x=\"200\" y=\"253\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Calls</text><text x=\"200\" y=\"270\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">at dawn, dusk</text><rect x=\"269\" y=\"165\" width=\"117\" height=\"115\" rx=\"10\" fill=\"#fff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><g transform=\"translate(315 213) scale(0.55 0.55)\"><ellipse cx=\"0\" cy=\"0\" rx=\"20\" ry=\"7\" fill=\"#2f3a2b\"/><path d=\"M16 -2 L36 -4 L36 1 L16 3Z\" fill=\"#2f3a2b\"/><ellipse cx=\"40\" cy=\"-2\" rx=\"6\" ry=\"4\" fill=\"#2f3a2b\"/><path d=\"M45 -3 L51 -1 L45 1Z\" fill=\"#2f3a2b\"/><path d=\"M-8 -3 L6 -30 L12 -3Z\" fill=\"#2f3a2b\"/><path d=\"M-20 0 L-28 -3 L-28 3Z\" fill=\"#2f3a2b\"/></g><g transform=\"translate(343 223) scale(0.45 0.45)\"><ellipse cx=\"0\" cy=\"0\" rx=\"20\" ry=\"7\" fill=\"#2f3a2b\"/><path d=\"M16 -2 L36 -4 L36 1 L16 3Z\" fill=\"#2f3a2b\"/><ellipse cx=\"40\" cy=\"-2\" rx=\"6\" ry=\"4\" fill=\"#2f3a2b\"/><path d=\"M45 -3 L51 -1 L45 1Z\" fill=\"#2f3a2b\"/><path d=\"M-8 -3 L6 -30 L12 -3Z\" fill=\"#2f3a2b\"/><path d=\"M-20 0 L-28 -3 L-28 3Z\" fill=\"#2f3a2b\"/></g><text x=\"327\" y=\"253\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Flocks</text><text x=\"327\" y=\"270\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">seen from road</text><text x=\"200\" y=\"294\" font-size=\"14\" font-weight=\"bold\" fill=\"#e8590c\" text-anchor=\"middle\">Fresh sign + birds seen = the X (Tip)</text>\n</svg>\n</figure><ul><li>Droppings, tracks, feathers, clipped grass, calls, flocks (Tip).</li><li>Fresh sign plus birds seen = the X (Tip).</li></ul><details class=\"more\"><summary>More: what this chapter covers</summary><ul><li>Tracks to scale and how to read them.</li><li>Droppings and how fresh they are.</li><li>Feathers, down and grazed ground.</li><li>Calls as sign.</li><li>Scouting the X step by step.</li><li>Following a flock without chasing it.</li></ul></details>","<figure class=\"diagram\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\" role=\"img\" aria-label=\"A goose track and a duck track drawn on a grid. The goose track is 10 to 12 centimetres long, 65 percent; a duck track 5 to 7.5 centimetres. Three webbed toes, the middle toe longest, toes turned in, 65 percent. About 15 centimetres between prints, 65 percent.\">\n  <rect width=\"400\" height=\"300\" fill=\"#fffaf0\"/>\n<text x=\"200\" y=\"24\" font-size=\"17\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">Goose track to scale (2 cm squares)</text><line x1=\"40\" y1=\"50\" x2=\"40\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"60\" y1=\"50\" x2=\"60\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"80\" y1=\"50\" x2=\"80\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"100\" y1=\"50\" x2=\"100\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"120\" y1=\"50\" x2=\"120\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"140\" y1=\"50\" x2=\"140\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"160\" y1=\"50\" x2=\"160\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"180\" y1=\"50\" x2=\"180\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"200\" y1=\"50\" x2=\"200\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"220\" y1=\"50\" x2=\"220\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"240\" y1=\"50\" x2=\"240\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"260\" y1=\"50\" x2=\"260\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"280\" y1=\"50\" x2=\"280\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"300\" y1=\"50\" x2=\"300\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"320\" y1=\"50\" x2=\"320\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"340\" y1=\"50\" x2=\"340\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"360\" y1=\"50\" x2=\"360\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"50\" x2=\"360\" y2=\"50\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"70\" x2=\"360\" y2=\"70\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"90\" x2=\"360\" y2=\"90\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"110\" x2=\"360\" y2=\"110\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"130\" x2=\"360\" y2=\"130\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"150\" x2=\"360\" y2=\"150\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"170\" x2=\"360\" y2=\"170\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"190\" x2=\"360\" y2=\"190\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"210\" x2=\"360\" y2=\"210\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><line x1=\"40\" y1=\"230\" x2=\"360\" y2=\"230\" stroke=\"#e0e0e0\" stroke-width=\"1\"/><g transform=\"translate(120 180) rotate(-8) scale(2.5)\"><path d=\"M0 0 L-22 -30 Q-18 -34 -14 -30 L-2 -12 L0 -40 Q4 -44 6 -40 L4 -12 L16 -30 Q20 -34 24 -28 L4 2 Q0 6 -4 2Z\" fill=\"#2f3a2b\" opacity=\".85\"/><path d=\"M-20 -28 Q2 -14 22 -28\" stroke=\"#2f3a2b\" stroke-width=\"2\" fill=\"none\"/></g><g transform=\"translate(280 150) rotate(8) scale(1.36)\"><path d=\"M0 0 L-22 -30 Q-18 -34 -14 -30 L-2 -12 L0 -40 Q4 -44 6 -40 L4 -12 L16 -30 Q20 -34 24 -28 L4 2 Q0 6 -4 2Z\" fill=\"#6b4f35\" opacity=\".85\"/><path d=\"M-20 -28 Q2 -14 22 -28\" stroke=\"#6b4f35\" stroke-width=\"2\" fill=\"none\"/></g><line x1=\"65\" y1=\"236\" x2=\"175\" y2=\"236\" stroke=\"#e8590c\" stroke-width=\"3\"/><text x=\"120\" y=\"252\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Goose 10 to 12 cm (65%)</text><line x1=\"250\" y1=\"236\" x2=\"310\" y2=\"236\" stroke=\"#e8590c\" stroke-width=\"3\"/><text x=\"280\" y=\"252\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Duck 5 to 7.5 cm</text><text x=\"200\" y=\"274\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">Middle toe longest, toes turn in (65%)</text><text x=\"200\" y=\"292\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">About 15 cm between prints (65%)</text>\n</svg>\n</figure><ul><li>Goose track: 10 to 12 cm, three webbed toes <span class=\"cert c-lo\" title=\"Certainty\">65%</span>.</li><li>Duck track: half the size, about 5 to 7.5 cm <span class=\"cert c-lo\" title=\"Certainty\">65%</span>.</li></ul><figure class=\"photo\"><img src=\"photos/hab-duck-tracks.jpg\" alt=\"Webbed tracks in mud: three forward toes joined by skin.\" loading=\"lazy\"><figcaption>Webbed tracks in mud: three forward toes joined by skin. <span class=\"credit\">Photo: Ryan Hodnett, CC BY-SA 4.0, <a href=\"https://commons.wikimedia.org/wiki/File:Anatidae_Footprints_-_Guelph,_Ontario_2020-04-12.jpg\" target=\"_blank\" rel=\"noopener\">source</a></span></figcaption></figure><details class=\"more\"><summary>More: tracks in full</summary><ul><li>Canada goose print about 10 to 12 cm (4 to 4.75 in) long; one measured about 11 cm by 5.5 cm (65%, naturalist sources).</li><li>Three forward toes joined by webbing, a small back toe that rarely prints, middle toe longest <span class=\"cert c-lo\" title=\"Certainty\">65%</span>.</li><li>Prints turn in a little and alternate left and right, about 15 cm (6 in) apart <span class=\"cert c-lo\" title=\"Certainty\">65%</span>.</li><li>Gull tracks top out near 9.5 cm (3.75 in) and are slimmer <span class=\"cert c-lo\" title=\"Certainty\">60%</span>.</li><li>Where to look: soft mud at the water's edge, field puddles, sand bars (Tip).</li><li>Many tracks pointing the same way along a shore: a loafing spot (Tip).</li></ul></details>","<figure class=\"diagram\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\" role=\"img\" aria-label=\"Three panels of goose droppings by age, all a Tip. Fresh, today: green, wet and shiny. A day or two: dull, darker, with a firm skin. Old: dry, pale and crumbly. Droppings are 5 to 10 centimetres long and finger thin, green on grass and browner on grain, 65 percent. Rain and frost change the look, so compare spots.\">\n  <rect width=\"400\" height=\"300\" fill=\"#fffaf0\"/>\n<text x=\"200\" y=\"24\" font-size=\"17\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">How fresh? Read the droppings (Tip)</text><rect x=\"10\" y=\"44\" width=\"120\" height=\"190\" rx=\"10\" fill=\"#fff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><g transform=\"translate(70 100) rotate(0) scale(1.6)\"><rect x=\"-18\" y=\"-5\" width=\"36\" height=\"10\" rx=\"5\" fill=\"#4caf50\"/><rect x=\"12\" y=\"-5\" width=\"6\" height=\"10\" rx=\"3\" fill=\"#f5f5f5\"/><path fill=\"none\" d=\"M-12 -2 L4 -2\" stroke=\"#fff\" stroke-width=\"2\" opacity=\".7\"/></g><g transform=\"translate(60 140) rotate(25) scale(1.3)\"><rect x=\"-18\" y=\"-5\" width=\"36\" height=\"10\" rx=\"5\" fill=\"#4caf50\"/><rect x=\"12\" y=\"-5\" width=\"6\" height=\"10\" rx=\"3\" fill=\"#f5f5f5\"/><path fill=\"none\" d=\"M-12 -2 L4 -2\" stroke=\"#fff\" stroke-width=\"2\" opacity=\".7\"/></g><text x=\"70\" y=\"180\" font-size=\"14\" font-weight=\"bold\" fill=\"#e8590c\" text-anchor=\"middle\">Fresh</text><text x=\"70\" y=\"200\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">today: green,</text><text x=\"70\" y=\"218\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">wet, shiny</text><rect x=\"140\" y=\"44\" width=\"120\" height=\"190\" rx=\"10\" fill=\"#fff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><g transform=\"translate(200 100) rotate(0) scale(1.6)\"><rect x=\"-18\" y=\"-5\" width=\"36\" height=\"10\" rx=\"5\" fill=\"#556b2f\"/><rect x=\"12\" y=\"-5\" width=\"6\" height=\"10\" rx=\"3\" fill=\"#f5f5f5\"/></g><g transform=\"translate(190 140) rotate(25) scale(1.3)\"><rect x=\"-18\" y=\"-5\" width=\"36\" height=\"10\" rx=\"5\" fill=\"#556b2f\"/><rect x=\"12\" y=\"-5\" width=\"6\" height=\"10\" rx=\"3\" fill=\"#f5f5f5\"/></g><text x=\"200\" y=\"180\" font-size=\"14\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">A day or two</text><text x=\"200\" y=\"200\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">dull, darker,</text><text x=\"200\" y=\"218\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">firm skin</text><rect x=\"270\" y=\"44\" width=\"120\" height=\"190\" rx=\"10\" fill=\"#fff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><g transform=\"translate(330 100) rotate(0) scale(1.6)\"><rect x=\"-18\" y=\"-5\" width=\"36\" height=\"10\" rx=\"5\" fill=\"#bcaaa4\"/><rect x=\"12\" y=\"-5\" width=\"6\" height=\"10\" rx=\"3\" fill=\"#f5f5f5\"/></g><g transform=\"translate(320 140) rotate(25) scale(1.3)\"><rect x=\"-18\" y=\"-5\" width=\"36\" height=\"10\" rx=\"5\" fill=\"#bcaaa4\"/><rect x=\"12\" y=\"-5\" width=\"6\" height=\"10\" rx=\"3\" fill=\"#f5f5f5\"/></g><text x=\"330\" y=\"180\" font-size=\"14\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">Old</text><text x=\"330\" y=\"200\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">dry, pale,</text><text x=\"330\" y=\"218\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">crumbles</text><text x=\"200\" y=\"256\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Size: 5 to 10 cm, finger thin (65%)</text><text x=\"200\" y=\"276\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"middle\">Green on grass, browner on grain (65%)</text><text x=\"200\" y=\"294\" font-size=\"14\" fill=\"#2f3a2b\" text-anchor=\"middle\">Rain and frost change the look: compare spots</text>\n</svg>\n</figure><ul><li>Tubes 5 to 10 cm long, green on grass <span class=\"cert c-lo\" title=\"Certainty\">65%</span>.</li><li>Wet and shiny means today (Tip).</li></ul><details class=\"more\"><summary>More: droppings in full</summary><ul><li>Tubular, 5 to 10 cm (2 to 4 in) long, a bit thinner than a finger, green when geese graze grass (65%, naturalist and wildlife control sources).</li><li>They often lie in piles where geese feed and rest <span class=\"cert c-lo\" title=\"Certainty\">65%</span>.</li><li>Lots of them: grass passes in about 1.5 hours and grazing geese digest only a third of it <span class=\"cert c-lo\" title=\"Certainty\">70%</span>. See <a href=\"#/s/mc-geese-02\">Chapter 2</a>.</li><li>Freshness ladder (Tip): wet, bright and shiny today; dull with a skin after a day or two; dry, pale and crumbly when old. Rain softens old ones and frost hardens new ones, so compare several spots.</li><li>Many fresh droppings in one patch of a big field marks the X (65%, Ducks Unlimited goose guide).</li></ul></details>","<div class=\"gallery\"><figure class=\"photo\"><img src=\"photos/hab-geese-stubble.jpg\" alt=\"Feeding geese in stubble leave droppings, feathers and clipped stems.\" loading=\"lazy\"><figcaption>Feeding geese in stubble leave droppings, feathers and clipped stems. <span class=\"credit\">Photo: Andrea_44 from Leamington, Ontario , Canada, CC BY 2.0, <a href=\"https://commons.wikimedia.org/wiki/File:Geese_in_the_corn_field_stubble_(5372865305).jpg\" target=\"_blank\" rel=\"noopener\">source</a></span></figcaption></figure><figure class=\"photo\"><img src=\"photos/hab-kamloops-pond-farm.jpg\" alt=\"Hay field edges by water: check for clipped grass and droppings.\" loading=\"lazy\"><figcaption>Hay field edges by water: check for clipped grass and droppings. <span class=\"credit\">Photo: cogdogblog, CC BY 2.0, <a href=\"https://commons.wikimedia.org/wiki/File:Start_of_the_Mara_Trail,_Lac_Du_Bois_Grasslands_Protected_Area_(15721994786).jpg\" target=\"_blank\" rel=\"noopener\">source</a></span></figcaption></figure></div><ul><li>Body feathers and down on the X (Tip).</li><li>Grass clipped short, grain picked clean (Tip).</li></ul><details class=\"more\"><summary>More: what to look for</summary><ul><li>Fresh down caught on stubble or floating at the water's edge: birds were there recently (Tip).</li><li>Long flight feathers on summer shorelines: a moult site <span class=\"cert c-lo\" title=\"Certainty\">70%</span>. Geese drop all flight feathers at once in June to August <span class=\"cert c-lo\" title=\"Certainty\">70%</span>.</li><li>Grazed grass looks mowed in patches, with droppings among the stems (Tip).</li><li>Puddles in a field with tracks around the edge: a drinking spot (Tip).</li></ul></details>","<figure class=\"video\"><video controls preload=\"none\" playsinline src=\"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a6/Canada_geese_%28Branta_canadensis%29_in_flight.webm/Canada_geese_%28Branta_canadensis%29_in_flight.webm.480p.vp9.webm\"></video><figcaption>Canada geese in flight: listen to the honks. <span class=\"credit\">Video: tuchodi, CC BY 2.0, <a href=\"https://commons.wikimedia.org/wiki/File:Canada_geese_(Branta_canadensis)_in_flight.webm\" target=\"_blank\" rel=\"noopener\">source</a>. Needs internet.</span></figcaption></figure><ul><li>At dawn and dusk, listen from the road: honks show the roost and the line (Tip).</li><li>High yelps in the flock: cacklers mixed in <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li></ul><details class=\"more\"><summary>More: how to listen</summary><ul><li>Geese are very vocal in flight and in big flocks (75%, Ducks Unlimited).</li><li>Cackling geese call higher than Canada geese <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li><li>Snow geese give a high \"kow luk\" <span class=\"cert c-lo\" title=\"Certainty\">75%</span>. White fronted geese a laughing \"kow kow kow\" <span class=\"cert c-mid\" title=\"Certainty\">80%</span>.</li><li>Stand outside the truck with the engine off for 10 minutes before first light (Tip).</li></ul></details>","<div class=\"steps\" data-n=\"5\"><div class=\"steps-head\"><b>Scout the X in 5 steps</b><span class=\"steps-count\">1 of 5</span></div><div class=\"steps-track\"><figure class=\"step-frame\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\" role=\"img\" aria-label=\"Scouting step 1: park on a public road at the last hour of light and glass the fields with binoculars. Geese fly in. Never trespass, 99 percent.\">\n  <rect width=\"400\" height=\"300\" fill=\"#fffaf0\"/>\n<text x=\"200\" y=\"24\" font-size=\"17\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">Scout 1: glass at last light from the road</text><rect x=\"0\" y=\"40\" width=\"400\" height=\"260\" rx=\"0\" fill=\"#dfe6d3\"/><rect x=\"150\" y=\"70\" width=\"230\" height=\"170\" rx=\"4\" fill=\"#d9c48f\" stroke=\"#6b4f35\" stroke-width=\"2\"/><line x1=\"0\" y1=\"262\" x2=\"400\" y2=\"262\" stroke=\"#9e9e9e\" stroke-width=\"10\"/><text x=\"60\" y=\"285\" font-size=\"14\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">Public road</text><g transform=\"translate(70 255)\"><circle cx=\"0\" cy=\"0\" r=\"10\" fill=\"#e8590c\"/></g><path d=\"M80 250 L170 120 L200 140 Z\" fill=\"#e8590c\" opacity=\".25\"/><g transform=\"translate(250 100) scale(0.6 0.6)\"><ellipse cx=\"0\" cy=\"0\" rx=\"20\" ry=\"7\" fill=\"#2f3a2b\"/><path d=\"M16 -2 L36 -4 L36 1 L16 3Z\" fill=\"#2f3a2b\"/><ellipse cx=\"40\" cy=\"-2\" rx=\"6\" ry=\"4\" fill=\"#2f3a2b\"/><path d=\"M45 -3 L51 -1 L45 1Z\" fill=\"#2f3a2b\"/><path d=\"M-8 -3 L6 -30 L12 -3Z\" fill=\"#2f3a2b\"/><path d=\"M-20 0 L-28 -3 L-28 3Z\" fill=\"#2f3a2b\"/></g><g transform=\"translate(280 90) scale(0.5 0.5)\"><ellipse cx=\"0\" cy=\"0\" rx=\"20\" ry=\"7\" fill=\"#2f3a2b\"/><path d=\"M16 -2 L36 -4 L36 1 L16 3Z\" fill=\"#2f3a2b\"/><ellipse cx=\"40\" cy=\"-2\" rx=\"6\" ry=\"4\" fill=\"#2f3a2b\"/><path d=\"M45 -3 L51 -1 L45 1Z\" fill=\"#2f3a2b\"/><path d=\"M-8 -3 L6 -30 L12 -3Z\" fill=\"#2f3a2b\"/><path d=\"M-20 0 L-28 -3 L-28 3Z\" fill=\"#2f3a2b\"/></g><text x=\"275\" y=\"290\" font-size=\"14\" fill=\"#2f3a2b\" text-anchor=\"middle\">Binoculars, no trespass (99%)</text>\n</svg>\n<figcaption><b>1.</b> Glass fields from a public road at the last hour of light.</figcaption></figure><figure class=\"step-frame\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\" role=\"img\" aria-label=\"Scouting step 2: watch where the flock lands and feeds, and drop a pin on that exact spot in the field, a Tip.\">\n  <rect width=\"400\" height=\"300\" fill=\"#fffaf0\"/>\n<text x=\"200\" y=\"24\" font-size=\"17\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">Scout 2: watch where they land, pin it</text><rect x=\"0\" y=\"40\" width=\"400\" height=\"260\" rx=\"0\" fill=\"#dfe6d3\"/><rect x=\"150\" y=\"70\" width=\"230\" height=\"170\" rx=\"4\" fill=\"#d9c48f\" stroke=\"#6b4f35\" stroke-width=\"2\"/><line x1=\"0\" y1=\"262\" x2=\"400\" y2=\"262\" stroke=\"#9e9e9e\" stroke-width=\"10\"/><text x=\"60\" y=\"285\" font-size=\"14\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">Public road</text><g transform=\"translate(260 150) scale(0.4 0.4)\"><path d=\"M-34 0 Q-38 -16 -18 -16 L12 -14 Q26 -10 24 2 Q18 12 -4 12 L-24 12 Q-36 8 -34 0Z\" fill=\"#7a6a58\"/><path d=\"M14 -10 Q30 -6 34 14 L28 16 Q24 0 12 -2Z\" fill=\"#2f3a2b\"/><ellipse cx=\"33\" cy=\"18\" rx=\"6\" ry=\"4\" fill=\"#2f3a2b\"/><path d=\"M30 16 Q34 22 36 19\" stroke=\"#fff\" stroke-width=\"2.5\" fill=\"none\"/><path fill=\"none\" d=\"M-6 12 L-8 24 M2 12 L4 24\" stroke=\"#2f3a2b\" stroke-width=\"3\"/></g><g transform=\"translate(284 150) scale(0.4 0.4)\"><path d=\"M-34 0 Q-38 -16 -18 -16 L12 -14 Q26 -10 24 2 Q18 12 -4 12 L-24 12