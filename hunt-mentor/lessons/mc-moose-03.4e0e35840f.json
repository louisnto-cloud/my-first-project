6 M65 255 l0 -7 M69 255 l-2 -6\" stroke=\"#a9b37f\" stroke-width=\"1.3\" fill=\"none\"/><path d=\"M47 241 l2 -6 M51 241 l0 -7 M55 241 l-2 -6\" stroke=\"#a9b37f\" stroke-width=\"1.3\" fill=\"none\"/><path d=\"M331 209 l2 -6 M335 209 l0 -7 M339 209 l-2 -6\" stroke=\"#a9b37f\" stroke-width=\"1.3\" fill=\"none\"/><path d=\"M211 210 l2 -6 M215 210 l0 -7 M219 210 l-2 -6\" stroke=\"#a9b37f\" stroke-width=\"1.3\" fill=\"none\"/><path d=\"M37 279 l2 -6 M41 279 l0 -7 M45 279 l-2 -6\" stroke=\"#a9b37f\" stroke-width=\"1.3\" fill=\"none\"/>\n<g stroke=\"#4a7fb0\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" opacity=\".85\"><path d=\"M36 44 v52 m-7 -10 l7 10 l7 -10\"><animateTransform attributeName=\"transform\" type=\"translate\" values=\"0 0;0 16;0 0\" dur=\"2s\" begin=\"0s\" repeatCount=\"indefinite\"/></path></g>\n<g stroke=\"#4a7fb0\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" opacity=\".85\"><path d=\"M364 44 v52 m-7 -10 l7 10 l7 -10\"><animateTransform attributeName=\"transform\" type=\"translate\" values=\"0 0;0 16;0 0\" dur=\"2s\" begin=\"0.6s\" repeatCount=\"indefinite\"/></path></g>\n<g stroke=\"#4a7fb0\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" opacity=\".85\"><path d=\"M300 130 v52 m-7 -10 l7 10 l7 -10\"><animateTransform attributeName=\"transform\" type=\"translate\" values=\"0 0;0 16;0 0\" dur=\"2s\" begin=\"1.2s\" repeatCount=\"indefinite\"/></path></g>\n<text x=\"200\" y=\"24\" font-size=\"17\" font-weight=\"bold\" fill=\"#2c5d86\" text-anchor=\"middle\" stroke=\"#e7ecdc\" stroke-width=\"3.5\" paint-order=\"stroke\" stroke-linejoin=\"round\">Wind blows deer → you</text>\n<g transform=\"translate(212 96) scale(0.5 0.5)\"><path d=\"M-18 -32 L-19 0 M-11 -32 L-10 0\" stroke=\"#5a3e26\" stroke-width=\"3.4\" stroke-linecap=\"round\"/><path d=\"M14 -34 L19 -16 L16 0 M21 -34 L26 -16 L23 0\" stroke=\"#5a3e26\" stroke-width=\"3.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"/><path d=\"M-24 -44 C-24 -52 -10 -55 6 -54 C20 -54 31 -51 31 -41 C31 -33 25 -29 15 -29 L-16 -29 C-22 -29 -24 -35 -24 -44z\" fill=\"#9a7350\"/><path d=\"M-22 -44 L-31 -66 L-21 -70 L-11 -50z\" fill=\"#9a7350\"/><path d=\"M-29 -65 C-36 -68 -44 -64 -47 -59 L-45 -56 C-39 -56 -32 -57 -25 -61z\" fill=\"#9a7350\"/><path d=\"M-47 -59 L-45 -56\" stroke=\"#1d1a16\" stroke-width=\"2.6\" stroke-linecap=\"round\"/><path d=\"M-25 -68 C-18 -78 -12 -80 -10 -78 C-13 -72 -18 -67 -23 -65z\" fill=\"#9a7350\" stroke=\"#5a3e26\" stroke-width=\".8\"/><circle cx=\"-34\" cy=\"-63\" r=\"1.3\" fill=\"#111\"/><ellipse cx=\"28\" cy=\"-42\" rx=\"4.5\" ry=\"8\" fill=\"#f3ead8\"/><path d=\"M30 -48 C34 -44 34 -40 31 -37 L29 -45z\" fill=\"#1d1a16\"/></g>\n<text x=\"200\" y=\"116\" font-size=\"16\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\" stroke=\"#e7ecdc\" stroke-width=\"3.5\" paint-order=\"stroke\" stroke-linejoin=\"round\">Deer</text>\n<circle cx=\"234.0\" cy=\"172.0\" r=\"17.0\" fill=\"#000\" opacity=\".12\"/><circle cx=\"234.0\" cy=\"170.0\" r=\"17.0\" fill=\"#3f6a34\"/><circle cx=\"228.9\" cy=\"164.9\" r=\"7.7\" fill=\"#fff\" opacity=\".12\"/>\n<circle cx=\"60.0\" cy=\"252.0\" r=\"12.0\" fill=\"#000\" opacity=\".12\"/><circle cx=\"60.0\" cy=\"250.0\" r=\"12.0\" fill=\"#3f6a34\"/><circle cx=\"56.4\" cy=\"246.4\" r=\"5.4\" fill=\"#fff\" opacity=\".12\"/>\n<circle cx=\"330.0\" cy=\"152.0\" r=\"13.0\" fill=\"#000\" opacity=\".12\"/><circle cx=\"330.0\" cy=\"150.0\" r=\"13.0\" fill=\"#3f6a34\"/><circle cx=\"326.1\" cy=\"146.1\" r=\"5.9\" fill=\"#fff\" opacity=\".12\"/>\n<circle cx=\"180.0\" cy=\"152.0\" r=\"10.0\" fill=\"#000\" opacity=\".12\"/><circle cx=\"180.0\" cy=\"150.0\" r=\"10.0\" fill=\"#3f6a34\"/><circle cx=\"177.0\" cy=\"147.0\" r=\"4.5\" fill=\"#fff\" opacity=\".12\"/>\n<path d=\"M120 288 C 100 236, 170 236, 160 200 S 214 196, 232 208\" fill=\"none\" stroke=\"#e8590c\" stroke-width=\"2.5\" stroke-linecap=\"round\" pathLength=\"100\" stroke-dasharray=\"100\" stroke-dashoffset=\"100\" opacity=\".8\"><animate attributeName=\"stroke-dashoffset\" values=\"100;0\" dur=\"7s\" fill=\"freeze\"/></path>\n<path id=\"stalk-wind-path\" d=\"M120 288 C 100 236, 170 236, 160 200 S 214 196, 232 208\" fill=\"none\" stroke=\"none\"/>\n<g><path d=\"M0 4 L-28 62 L28 62 Z\" fill=\"#e8590c\" opacity=\".18\"/><circle r=\"9\" fill=\"#e8590c\" stroke=\"#fffaf0\" stroke-width=\"2\"/><text x=\"14\" y=\"5\" font-size=\"15\" font-weight=\"bold\" fill=\"#c2410c\" stroke=\"#e7ecdc\" stroke-width=\"3.5\" paint-order=\"stroke\" stroke-linejoin=\"round\">You</text><animateMotion dur=\"7s\" fill=\"freeze\"><mpath href=\"#stalk-wind-path\"/></animateMotion></g>\n<text x=\"392\" y=\"250\" font-size=\"15\" fill=\"#2f3a2b\" text-anchor=\"end\" stroke=\"#e7ecdc\" stroke-width=\"3.5\" paint-order=\"stroke\" stroke-linejoin=\"round\">Your scent drifts</text>\n<text x=\"392\" y=\"268\" font-size=\"15\" fill=\"#2f3a2b\" text-anchor=\"end\" stroke=\"#e7ecdc\" stroke-width=\"3.5\" paint-order=\"stroke\" stroke-linejoin=\"round\">behind you, away</text>\n<text x=\"392\" y=\"286\" font-size=\"15\" fill=\"#2f3a2b\" text-anchor=\"end\" stroke=\"#e7ecdc\" stroke-width=\"3.5\" paint-order=\"stroke\" stroke-linejoin=\"round\">from the deer</text>\n<g opacity=\"0\"><animate attributeName=\"opacity\" values=\"0;1\" begin=\"6.5s\" dur=\".5s\" fill=\"freeze\"/><rect x=\"16\" y=\"120\" width=\"142\" height=\"40\" rx=\"8\" fill=\"#2f3a2b\"/><text x=\"87\" y=\"146\" font-size=\"16\" font-weight=\"bold\" fill=\"#ffffff\" text-anchor=\"middle\">In range, hidden</text></g>\n</svg>\n<figcaption>Keep the wind in your face. <button class=\"anim-replay\">↻ Replay</button></figcaption></figure><details class=\"more\"><summary>More: beating the senses in detail</summary><ul><li>Nose: check the wind every few minutes; play thermals (Tip, <a href=\"#/s/wind-thermals\">thermals</a>). Keep the shooter downwind of the caller (Tip, chapter 9).</li><li>Ears: still hunt slowly; stop often; let a snapped stick be followed by silence, a soft grunt or a branch rake rather than a curse (Tip).</li><li>Eyes: move when its head is down or behind cover; use trees and willow as screens; keep your outline off the skyline (Tip).</li><li>Scent products: no moose part or derivative from outside BC may be used for hunting (99%, page 12, <a href=\"#/s/rb-unlawful-acts\">unlawful acts</a>).</li></ul></details>","<figure class=\"diagram\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 258\" font-family=\"sans-serif\" role=\"img\" aria-label=\"Moose senses ranked. Nose: excellent, wind at your back ends the stalk. Ears: very good, the big ears swivel and catch a snapped twig far away. Eyes: poor, they see motion but not detail. A moose often stands and stares instead of running.\">\n<rect x=\"0\" y=\"0\" width=\"400\" height=\"258\" fill=\"#fffaf0\"/>\n<text x=\"200\" y=\"26\" font-size=\"18\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">Moose senses</text><text x=\"8\" y=\"78.0\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"start\">Nose</text><rect x=\"80\" y=\"56\" width=\"222.9\" height=\"34\" rx=\"4\" fill=\"#e8590c\"/><text x=\"307.8571428571429\" y=\"78.0\" font-size=\"14\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"start\">excellent</text><text x=\"8\" y=\"134.0\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"start\">Ears</text><rect x=\"80\" y=\"112\" width=\"178.3\" height=\"34\" rx=\"4\" fill=\"#4a7fb0\"/><text x=\"263.2857142857143\" y=\"134.0\" font-size=\"14\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"start\">very good</text><text x=\"8\" y=\"190.0\" font-size=\"14\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"start\">Eyes</text><rect x=\"80\" y=\"168\" width=\"66.9\" height=\"34\" rx=\"4\" fill=\"#8a9a6b\"/><text x=\"151.85714285714286\" y=\"190.0\" font-size=\"14\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"start\">poor: motion only</text><text x=\"200\" y=\"246\" font-size=\"14\" fill=\"#6b4f35\" text-anchor=\"middle\">A staring moose has seen you (hunter lore).</text>\n</svg>\n</figure><ul><li><strong>Rhyme:</strong> \"Nose knows, ears tell, eyes are slow, so freeze as well.\"</li><li><strong>Number trick:</strong> 3 km: how far a cow's rut moan carries <span class=\"cert c-mid\" title=\"Certainty\">90%</span>.</li><li><strong>Old hand's rule</strong> (tradition): \"A moose trusts its nose every time.\"</li></ul><details class=\"more\"><summary>More: more hooks</summary><ul><li><strong>Rhyme:</strong> \"Morning air climbs, evening air falls; sit low by the swamp when the cow moose calls.\"</li><li><strong>Number trick:</strong> 1, 2, 3: one sound turns the ears, two the nose checks, three the eyes look (Tip, order of senses).</li><li><strong>Old hand's rule</strong> (widely reported, opinion): \"If he goes downwind, you go there first.\"</li><li><strong>Old hand's rule</strong> (opinion): \"A staring moose has already seen you.\"</li></ul><aside class=\"callout mistake\"><div class=\"callout-t\">Common mistakes</div><ul><li>Calling from a ridge top at evening with the cold air sliding down onto the swamp.</li><li>Moving while a moose stares.</li><li>Using a moose lure bought outside BC: unlawful.</li></ul></aside><aside class=\"callout field\"><div class=\"callout-t\">Do this in the field</div><p>At the next wetland you visit, stand at the edge at sunset with a wind checker. Watch which way the puff goes in the last 30 minutes of light.</p></aside></details>","<ul><li>BC Ministry of Environment, Lands and Parks (2000), <a href=\"https://www.env.gov.bc.ca/wld/documents/moose.pdf\" target=\"_blank\" rel=\"noopener\">\"Moose in British Columbia\"</a>, read directly, checked 2026-10-11 <span class=\"cert c-mid\" title=\"Certainty\">90%</span></li><li>Minnesota Department of Natural Resources, <a href=\"https://www.dnr.state.mn.us/mammals/moose.html\" target=\"_blank\" rel=\"noopener\">Moose</a>, checked 2026-10-11 <span class=\"cert c-lo\" title=\"Certainty\">75%</span></li><li>Ken Bailey, Outdoor Canada (5 September 2012), <a href=\"https://www.outdoorcanada.ca/?p=3913\" target=\"_blank\" rel=\"noopener\">\"Make like a cow moose\"</a>, checked 2026-10-11 (65%, hunting writer: tactics are Tip)</li><li>Moose calling threads and guide articles found by search (Outdoor Life, Guidefitter, Rokslide), checked 2026-10-11 (60%, opinion)</li><li>Hunt Mentor sessions: <a href=\"#/s/wind-thermals\">thermals</a>, <a href=\"#/s/moose\">Moose</a>, <a href=\"#/s/mc-mule-deer-03\">Mule deer Masterclass 3</a> (75 to 85% as marked there)</li><li>BC Hunting and Trapping Regulations Synopsis 2026 to 2028, page 12, via <a href=\"#/s/rb-unlawful-acts\">unlawful acts</a> <span class=\"cert c-hi\" title=\"Certainty\">99%</span></li><li>Research notes: <code>research/2026-10-11-masterclass-moose.md</code>.</li></ul>"]