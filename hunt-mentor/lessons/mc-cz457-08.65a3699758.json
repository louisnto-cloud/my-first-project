ct x=\"386\" y=\"106\" width=\"5\" height=\"10\" rx=\"1\" fill=\"#2B3034\"/><rect x=\"255\" y=\"99\" width=\"16\" height=\"7\" rx=\"1.5\" fill=\"#2B3034\"/><rect x=\"266\" y=\"96\" width=\"4\" height=\"4\" fill=\"#2B3034\"/><path d=\"M374 107 L376 97 L388 97 L388 107 Z\" fill=\"#2B3034\"/><rect x=\"140\" y=\"102\" width=\"94\" height=\"17\" rx=\"3\" fill=\"#4A5156\"/><rect x=\"150\" y=\"99\" width=\"78\" height=\"4\" fill=\"#8C959B\"/><rect x=\"160\" y=\"100\" width=\"2\" height=\"2\" fill=\"#2B3034\"/><rect x=\"210\" y=\"100\" width=\"2\" height=\"2\" fill=\"#2B3034\"/><rect x=\"176\" y=\"105\" width=\"36\" height=\"8\" rx=\"1.5\" fill=\"#2B3034\"/><rect x=\"100\" y=\"106\" width=\"78\" height=\"9\" rx=\"2\" fill=\"#C9CFD3\"/><rect x=\"94\" y=\"104\" width=\"13\" height=\"13\" rx=\"3\" fill=\"#2B3034\"/><rect x=\"87\" y=\"107\" width=\"8\" height=\"7\" rx=\"2\" fill=\"#D8B23A\"/><path d=\"M120 108 L128 88\" stroke=\"#2B3034\" stroke-width=\"5\" stroke-linecap=\"round\"/><circle cx=\"130\" cy=\"83\" r=\"6.5\" fill=\"#2B3034\"/><rect x=\"176\" y=\"105\" width=\"36\" height=\"8\" rx=\"1.5\" fill=\"#2B3034\"/><rect x=\"130\" y=\"119\" width=\"22\" height=\"6\" rx=\"2\" fill=\"#2B3034\"/><circle cx=\"146\" cy=\"122\" r=\"2.6\" fill=\"#FFFFFF\"/><rect x=\"131\" y=\"117.5\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#D8B23A\" stroke=\"#2B3034\" stroke-width=\".8\"/><path d=\"M158 141 Q156 160 176 160 L196 160 Q204 160 204 141\" stroke=\"#2B3034\" stroke-width=\"3\" fill=\"none\"/><path d=\"M178 141 Q183 150 176 156\" stroke=\"#2B3034\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\"/><rect x=\"231\" y=\"139\" width=\"4\" height=\"9\" rx=\"1\" fill=\"#D8B23A\"/><circle cx=\"70\" cy=\"158\" r=\"2.6\" fill=\"#2B3034\"/><circle cx=\"300\" cy=\"138\" r=\"2.6\" fill=\"#2B3034\"/></g><g transform=\"translate(0 -60)\"><line x1=\"150\" y1=\"150\" x2=\"121.0\" y2=\"150.0\" stroke=\"#FF6A13\" stroke-width=\"4\" stroke-linecap=\"round\"/><path d=\"M110 150 L121.0 156.0 L121.0 144.0z\" fill=\"#FF6A13\"/></g><text x=\"200\" y=\"236\" font-size=\"15\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#17201A\">Lift and pull it back to the stop.</text><rect x=\"8\" y=\"254\" width=\"384\" height=\"36\" rx=\"9\" fill=\"#1F3D2B\"/><text x=\"200\" y=\"277\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">Muzzle safe. Finger off. Treat it as loaded.</text></svg>\n<figcaption><b>3.</b> Open the bolt fully back.</figcaption></figure><figure class=\"step-frame\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\" role=\"img\" aria-label=\"Taking the bolt out of the CZ 457, step 4 of 4: Press catch, pull bolt. Hold the catch in. Slide the bolt out.\"><rect x=\"0\" y=\"0\" width=\"400\" height=\"300\" fill=\"#EEF1EA\"/><circle cx=\"26\" cy=\"26\" r=\"14\" fill=\"#FF6A13\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"26\" y=\"31\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">4</text><text x=\"48\" y=\"32\" font-size=\"17\" font-weight=\"bold\" text-anchor=\"start\" fill=\"#1F3D2B\">Press catch, pull bolt</text><g transform=\"translate(0 10) scale(1.0)\"><path d=\"M14 108 L128 116 L140 118 L300 120 Q314 121 318 126 L318 132 Q300 138 250 140 L200 141 L162 141 Q150 141 146 150 L136 170 Q132 176 124 174 L120 172 Q126 156 122 146 Q112 142 96 146 L14 168 Z\" fill=\"#9A6B3F\"/><path d=\"M30 116 Q80 120 120 124\" stroke=\"#6E4A2A\" stroke-width=\"1.2\" fill=\"none\"/><rect x=\"7\" y=\"106\" width=\"8\" height=\"64\" rx=\"2\" fill=\"#2B3034\"/><path d=\"M232 105 L390 107 L390 115 L232 117 Z\" fill=\"#4A5156\"/><rect x=\"386\" y=\"106\" width=\"5\" height=\"10\" rx=\"1\" fill=\"#2B3034\"/><rect x=\"255\" y=\"99\" width=\"16\" height=\"7\" rx=\"1.5\" fill=\"#2B3034\"/><rect x=\"266\" y=\"96\" width=\"4\" height=\"4\" fill=\"#2B3034\"/><path d=\"M374 107 L376 97 L388 97 L388 107 Z\" fill=\"#2B3034\"/><rect x=\"140\" y=\"102\" width=\"94\" height=\"17\" rx=\"3\" fill=\"#4A5156\"/><rect x=\"150\" y=\"99\" width=\"78\" height=\"4\" fill=\"#8C959B\"/><rect x=\"160\" y=\"100\" width=\"2\" height=\"2\" fill=\"#2B3034\"/><rect x=\"210\" y=\"100\" width=\"2\" height=\"2\" fill=\"#2B3034\"/><rect x=\"176\" y=\"105\" width=\"36\" height=\"8\" rx=\"1.5\" fill=\"#2B3034\"/><rect x=\"130\" y=\"119\" width=\"22\" height=\"6\" rx=\"2\" fill=\"#2B3034\"/><circle cx=\"146\" cy=\"122\" r=\"2.6\" fill=\"#FFFFFF\"/><rect x=\"131\" y=\"117.5\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#D8B23A\" stroke=\"#2B3034\" stroke-width=\".8\"/><path d=\"M158 141 Q156 160 176 160 L196 160 Q204 160 204 141\" stroke=\"#2B3034\" stroke-width=\"3\" fill=\"none\"/><path d=\"M178 141 Q183 150 176 156\" stroke=\"#2B3034\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\"/><rect x=\"231\" y=\"139\" width=\"4\" height=\"9\" rx=\"1\" fill=\"#D8B23A\"/><circle cx=\"70\" cy=\"158\" r=\"2.6\" fill=\"#2B3034\"/><circle cx=\"300\" cy=\"138\" r=\"2.6\" fill=\"#2B3034\"/></g><g transform=\"translate(0 -60)\"><rect x=\"20\" y=\"166\" width=\"96\" height=\"9\" rx=\"2\" fill=\"#C9CFD3\"/><rect x=\"12\" y=\"164\" width=\"12\" height=\"13\" rx=\"3\" fill=\"#2B3034\"/><line x1=\"130\" y1=\"160\" x2=\"71.0\" y2=\"160.0\" stroke=\"#FF6A13\" stroke-width=\"3\" stroke-linecap=\"round\"/><path d=\"M60 160 L71.0 166.0 L71.0 154.0z\" fill=\"#FF6A13\"/><text x=\"200\" y=\"274\" font-size=\"15\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FF6A13\">The catch is on the LEFT side.</text></g><text x=\"200\" y=\"236\" font-size=\"15\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#17201A\">Hold the catch in. Slide the bolt out.</text><rect x=\"8\" y=\"254\" width=\"384\" height=\"36\" rx=\"9\" fill=\"#1F3D2B\"/><text x=\"200\" y=\"277\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">Muzzle safe. Finger off. Treat it as loaded.</text></svg>\n<figcaption><b>4.</b> Hold the bolt catch in. Slide the bolt out.</figcaption></figure></div><div class=\"steps-nav\"><button class=\"steps-prev\" aria-label=\"Back\">‹ Back</button><span class=\"steps-dots\"><i></i><i></i><i></i><i></i></span><button class=\"steps-next\" aria-label=\"Next\">Next ›</button></div></div><ul><li>The bolt catch is on the left of the receiver <span class=\"cert c-hi\" title=\"Certainty\">95%</span>.</li></ul><details class=\"more\"><summary>More: the steps in full</summary><ol><li>Point safe, finger off. Magazine out, bolt open, look and feel: empty (85%, ACTS and PROVE).</li><li>\"Shift the safety to its \"Off\" position\" (95%, CZ manual page 9, step 2). Only on a proven empty rifle.</li><li>Open the bolt all the way back <span class=\"cert c-hi\" title=\"Certainty\">95%</span>.</li><li>\"Depressing the bolt catch (Fig.10) ... pull the bolt out of the gun\" <span class=\"cert c-hi\" title=\"Certainty\">95%</span>. Fig. 10 shows the catch on the left side <span class=\"cert c-hi\" title=\"Certainty\">95%</span>.</li><li>CZ also lists pulling the bolt out with the safety engaged as a feature (95%, page 4). The stripping steps still say safety off. My lean: follow the stripping steps (Tip).</li><li>Lay the bolt on a clean cloth, not on the ground (Tip).</li></ol></details>","<figure class=\"diagram\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 392\" font-family=\"sans-serif\" role=\"img\" aria-label=\"The CZ 457 bolt out of the rifle: 1 bolt body, 2 bolt handle, 3 handle ball, 4 cocking indicator at the rear, 5 extractor at the front, 6 bolt guide. The striker and its spring are inside; CZ says leave further stripping to a gunsmith.\"><rect x=\"0\" y=\"0\" width=\"400\" height=\"392\" fill=\"#EEF1EA\"/><text x=\"200\" y=\"27\" font-size=\"18\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#1F3D2B\">The bolt, out of the rifle</text><rect x=\"70\" y=\"120\" width=\"250\" height=\"26\" rx=\"6\" fill=\"#C9CFD3\" stroke=\"#2B3034\" stroke-width=\"1.2\"/><rect x=\"120\" y=\"113\" width=\"150\" height=\"7\" rx=\"2\" fill=\"#8C959B\"/><rect x=\"40\" y=\"117\" width=\"34\" height=\"32\" rx=\"6\" fill=\"#2B3034\"/><rect x=\"26\" y=\"125\" width=\"16\" height=\"16\" rx=\"4\" fill=\"#D8B23A\"/><path d=\"M96 146 L82 196\" stroke=\"#2B3034\" stroke-width=\"9\" stroke-linecap=\"round\"/><circle cx=\"80\" cy=\"206\" r=\"13\" fill=\"#2B3034\"/><path d=\"M312 120 L330 118 L332 126 L316 128 Z\" fill=\"#2B3034\"/><rect x=\"320\" y=\"124\" width=\"6\" height=\"18\" rx=\"2\" fill=\"#2B3034\"/><line x1=\"200\" y1=\"133\" x2=\"200\" y2=\"80\" stroke=\"#17201A\" stroke-width=\"1.2\"/><circle cx=\"200\" cy=\"133\" r=\"2.2\" fill=\"#17201A\"/><line x1=\"92\" y1=\"160\" x2=\"140\" y2=\"196\" stroke=\"#17201A\" stroke-width=\"1.2\"/><circle cx=\"92\" cy=\"160\" r=\"2.2\" fill=\"#17201A\"/><line x1=\"80\" y1=\"206\" x2=\"40\" y2=\"240\" stroke=\"#17201A\" stroke-width=\"1.2\"/><circle cx=\"80\" cy=\"206\" r=\"2.2\" fill=\"#17201A\"/><line x1=\"32\" y1=\"133\" x2=\"28\" y2=\"82\" stroke=\"#17201A\" stroke-width=\"1.2\"/><circle cx=\"32\" cy=\"133\" r=\"2.2\" fill=\"#17201A\"/><line x1=\"324\" y1=\"122\" x2=\"352\" y2=\"82\" stroke=\"#17201A\" stroke-width=\"1.2\"/><circle cx=\"324\" cy=\"122\" r=\"2.2\" fill=\"#17201A\"/><line x1=\"160\" y1=\"116\" x2=\"130\" y2=\"80\" stroke=\"#17201A\" stroke-width=\"1.2\"/><circle cx=\"160\" cy=\"116\" r=\"2.2\" fill=\"#17201A\"/><circle cx=\"200\" cy=\"80\" r=\"11\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"200\" y=\"85\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">1</text><circle cx=\"140\" cy=\"196\" r=\"11\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"140\" y=\"201\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">2</text><circle cx=\"40\" cy=\"240\" r=\"11\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"40\" y=\"245\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">3</text><circle cx=\"28\" cy=\"82\" r=\"11\" fill=\"#FF6A13\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"28\" y=\"87\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">4</text><circle cx=\"352\" cy=\"82\" r=\"11\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"352\" y=\"87\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">5</text><circle cx=\"130\" cy=\"80\" r=\"11\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"130\" y=\"85\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">6</text><circle cx=\"26\" cy=\"269\" r=\"10\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"26\" y=\"274\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">1</text><text x=\"42\" y=\"274\" font-size=\"15\" font-weight=\"normal\" text-anchor=\"start\" fill=\"#17201A\">Bolt body</text><circle cx=\"26\" cy=\"291\" r=\"10\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"26\" y=\"296\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">2</text><text x=\"42\" y=\"296\" font-size=\"15\" font-weight=\"normal\" text-anchor=\"start\" fill=\"#17201A\">Bolt handle</text><circle cx=\"26\" cy=\"313\" r=\"10\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"26\" y=\"318\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">3</text><text x=\"42\" y=\"318\" font-size=\"15\" font-weight=\"normal\" text-anchor=\"start\" fill=\"#17201A\">Handle ball</text><circle cx=\"216\" cy=\"269\" r=\"10\" fill=\"#FF6A13\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"216\" y=\"274\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">4</text><text x=\"232\" y=\"274\" font-size=\"15\" font-weight=\"normal\" text-anchor=\"start\" fill=\"#17201A\">Cocking indicator</text><circle cx=\"216\" cy=\"291\" r=\"10\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"216\" y=\"296\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">5</text><text x=\"232\" y=\"296\" font-size=\"15\" font-weight=\"normal\" text-anchor=\"start\" fill=\"#17201A\">Extractor</text><circle cx=\"216\" cy=\"313\" r=\"10\" fill=\"#1F3D2B\" stroke=\"#FFFFFF\" stroke-width=\"1.5\"/><text x=\"216\" y=\"318\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">6</text><text x=\"232\" y=\"318\" font-size=\"15\" font-weight=\"normal\" text-anchor=\"start\" fill=\"#17201A\">Bolt guide</text><rect x=\"8\" y=\"346\" width=\"384\" height=\"34\" rx=\"9\" fill=\"#1F3D2B\"/><text x=\"200\" y=\"368.0\" font-size=\"15\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#FFFFFF\">Striker and spring inside: gunsmith only</text><text x=\"200\" y=\"54\" font-size=\"14\" font-weight=\"normal\" text-anchor=\"middle\" fill=\"#17201A\">Part names from the CZ manual parts list</text></svg>\n</figure><ul><li>Wipe it, light oil, put it back <span class=\"cert c-hi\" title=\"Certainty\">95%</span>.</li><li>Do not pull the striker out <span class=\"cert c-hi\" title=\"Certainty\">95%</span>.</li></ul><details class=\"more\"><summary>More: what you may clean on the bolt</summary><ul><li>Outside of the bolt, the bolt face and around the extractor: cloth, old toothbrush, light oil, then wipe off (95%, CZ manual page 10, \"cleaning of other parts\").</li><li>The firing pin hole: CZ's misfire remedy is \"disassemble and clean the firing pin\", but its stripping section says that is beyond routine maintenance (95%, pages 9 and 11). My reading: a gunsmith job <span class=\"cert c-mid\" title=\"Certainty\">85%</span>.</li><li>Do not soak the bolt in solvent (95%, other parts rule).</li></ul></details>","<div class=\"steps\" data-n=\"3\"><div class=\"steps-head\"><b>Put the bolt back in 3 steps</b><span class=\"steps-count\">1 of 3</span></div><div class=\"steps-track\"><figure class=\"step-frame\"><svg xml