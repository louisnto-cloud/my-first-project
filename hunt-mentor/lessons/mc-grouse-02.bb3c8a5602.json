"none\" stroke-width=\"0\"/>\n<circle cx=\"200\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"217\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"234\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"251\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"268\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"285\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"302\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"319\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"336\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"353\" cy=\"103\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"30\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"47\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"64\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"81\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"98\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"115\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"132\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"149\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"166\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"183\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"200\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"217\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"234\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"251\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"268\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"285\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"302\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"319\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"336\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<circle cx=\"353\" cy=\"120\" r=\"6.5\" fill=\"#d8d2c4\" stroke=\"none\" stroke-width=\"0\"/>\n<text x=\"20\" y=\"160\" font-size=\"15\" fill=\"#23261f\" text-anchor=\"start\" font-weight=\"bold\">Over 3 in 4 die in the first 5 weeks,</text>\n<text x=\"20\" y=\"179\" font-size=\"15\" fill=\"#23261f\" text-anchor=\"start\" font-weight=\"bold\">most in week 1 (75%).</text>\n<rect x=\"20\" y=\"200\" width=\"360\" height=\"70\" rx=\"8\" fill=\"#ffffff\" stroke=\"#8a9a6b\" stroke-width=\"2\"/>\n<text x=\"34\" y=\"224\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"start\">Adults: about 1 in 2 lives through a year.</text>\n<text x=\"34\" y=\"242\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"start\">Few reach age 2. Hardest months: Jan to Mar.</text>\n</svg>\n</figure><ul><li>Most chicks die in the first weeks <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li><li>About half of adults live through each year <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li></ul><details class=\"more\"><summary>More: survival numbers</summary><ul><li>Over three quarters of ruffed grouse chicks die within 35 days of hatching, most in the first week (75%, Pennsylvania Game Commission).</li><li>About half of hens lose their whole brood in the first 1 to 2 weeks (85%, Hinterland Who's Who).</li><li>Adult yearly survival: about 50% in Pennsylvania <span class=\"cert c-lo\" title=\"Certainty\">75%</span>; 53% in Maryland; 32% for adults and 16% for young birds in Maine <span class=\"cert c-lo\" title=\"Certainty\">75%</span>. Winter, January to March, is the hardest time <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li><li>Few ruffed grouse live to age 2 <span class=\"cert c-lo\" title=\"Certainty\">75%</span>. Some are thought to live 11 years <span class=\"cert c-lo\" title=\"Certainty\">60%</span>.</li><li>Dusky grouse: about half die in their first year <span class=\"cert c-lo\" title=\"Certainty\">65%</span>.</li><li>Fat: grouse carry little fat compared with ducks. They survive winter by eating every day and roosting well, not by living off fat (Tip, 60%).</li><li>Hunting: in one large study hunting made up 12% of known deaths and looked compensatory, meaning it replaced other deaths <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li></ul></details>","<figure class=\"diagram\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 290\" role=\"img\" aria-label=\"Side view of a grouse. The heart sits low and forward in the chest, under the front of the breast meat and behind the wing root. The lungs sit above it, against the back. The head and neck sit just in front, circled as the target zone for a .22 so the breast meat is saved.\" font-family=\"sans-serif\">\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"290\" fill=\"#fffaf0\"/>\n<text x=\"200.0\" y=\"26\" font-size=\"18\" fill=\"#23261f\" text-anchor=\"middle\" font-weight=\"bold\">Where the vitals sit</text>\n<g transform=\"translate(200 170) scale(3.2 3.2)\"><polygon points=\"-20,-6 -38,-20 -48,-12 -52,0 -48,8 -20,8\" fill=\"#8b5a2b\"/><path d=\"M-40 -18 Q-50 -10 -48 6\" fill=\"none\" stroke=\"#23261f\" stroke-width=\"3\"/><ellipse cx=\"0\" cy=\"0\" rx=\"26\" ry=\"15\" fill=\"#c9a77f\"/><circle cx=\"21\" cy=\"-14\" r=\"8\" fill=\"#c9a77f\"/><polygon points=\"16,-20 20,-28 25,-20\" fill=\"#c9a77f\"/><polygon points=\"28,-16 35,-13 28,-10\" fill=\"#6b4f35\"/><circle cx=\"23\" cy=\"-16\" r=\"1.8\" fill=\"#23261f\"/><path d=\"M2 13 l-2 11 M10 13 l2 11\" stroke=\"#6b4f35\" stroke-width=\"2.5\" fill=\"none\"/></g>\n<ellipse cx=\"214\" cy=\"146\" rx=\"32\" ry=\"11\" fill=\"#b5524a\" opacity=\".9\"/>\n<ellipse cx=\"250\" cy=\"182\" rx=\"20\" ry=\"18\" fill=\"#c23b22\" opacity=\".9\"/>\n<circle cx=\"267\" cy=\"124\" r=\"34\" fill=\"none\" stroke=\"#2f3a2b\" stroke-width=\"4\" stroke-dasharray=\"6 4\"/>\n<text x=\"320\" y=\"70\" font-size=\"15\" fill=\"#2f3a2b\" text-anchor=\"middle\" font-weight=\"bold\">Head and</text>\n<text x=\"320\" y=\"88\" font-size=\"15\" fill=\"#2f3a2b\" text-anchor=\"middle\" font-weight=\"bold\">neck</text>\n<line x1=\"310\" y1=\"94\" x2=\"285\" y2=\"108\" stroke=\"#2f3a2b\" stroke-width=\"2\"/>\n<text x=\"80\" y=\"80\" font-size=\"15\" fill=\"#23261f\" text-anchor=\"middle\" font-weight=\"bold\">Lungs</text>\n<line x1=\"96\" y1=\"84\" x2=\"205\" y2=\"142\" stroke=\"#23261f\" stroke-width=\"1.5\"/>\n<text x=\"110\" y=\"268\" font-size=\"15\" fill=\"#23261f\" text-anchor=\"middle\" font-weight=\"bold\">Heart: low, forward</text>\n<line x1=\"160\" y1=\"255\" x2=\"244\" y2=\"192\" stroke=\"#23261f\" stroke-width=\"1.5\"/>\n<text x=\"395\" y=\"250\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"end\">Behind the wing root,</text>\n<text x=\"395\" y=\"268\" font-size=\"14\" fill=\"#23261f\" text-anchor=\"end\">under the front breast</text>\n</svg>\n</figure><ul><li>Rhyme: \"Crop to store, gizzard to grind, ceca to brew what's left behind.\"</li><li>Number trick: \"41 inside, minus 35 outside, snow between.\"</li><li>Old hand's rule (tradition): \"Check the crop, find the crop\": what is in it grows nearby.</li></ul><details class=\"more\"><summary>More: more hooks</summary><ul><li>\"White to fly, dark to walk.\"</li><li>\"Front half or nothing\": brain, spine, heart and lungs are all forward.</li><li>\"Two sets of sacs, one way through.\"</li><li>\"3 in 4 chicks gone by 5 weeks.\"</li><li>The crop check is common hunter practice written up in many hunting guides; the rhymes are made for this course.</li></ul></details>","<ul><li>Hinterland Who's Who, Pennsylvania Game Commission, peer reviewed reviews and studies. Checked 2026-10-11.</li></ul><details class=\"more\"><summary>More: every source</summary><ul><li><a href=\"https://www.hww.ca/en/wildlife/birds/ruffed-grouse.html\" target=\"_blank\" rel=\"noopener\">Hinterland Who's Who, Ruffed grouse</a> and <a href=\"https://www.hww.ca/assets/pdfs/factsheets/ptarmigan-en.pdf\" target=\"_blank\" rel=\"noopener\">Ptarmigan</a>, read directly <span class=\"cert c-mid\" title=\"Certainty\">85%</span>.</li><li><a href=\"https://www.pa.gov/agencies/pgc/wildlife/discover-pa-wildlife/ruffed-grouse\" target=\"_blank\" rel=\"noopener\">Pennsylvania Game Commission, Ruffed grouse</a>, read directly <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li><li><a href=\"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC11864838/\" target=\"_blank\" rel=\"noopener\">Unidirectional airflow, air sacs or the horizontal septum (2024 review)</a>, search preview <span class=\"cert c-mid\" title=\"Certainty\">80%</span>.</li><li><a href=\"https://pmc.ncbi.nlm.nih.gov/articles/PMC7151090\" target=\"_blank\" rel=\"noopener\">Avian heart scaling review</a>, search preview <span class=\"cert c-mid\" title=\"Certainty\">80%</span>.</li><li><a href=\"https://sora.unm.edu/sites/default/files/journals/condor/v080n02/p0243-p0245.pdf\" target=\"_blank\" rel=\"noopener\">Ruffed grouse body temperature, The Condor 80</a>, search preview <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li><li><a href=\"https://sora.unm.edu/sites/default/files/journals/wilson/v099n03/p0488-p0490.pdf\" target=\"_blank\" rel=\"noopener\">Snow roost temperatures, Wilson Bulletin 99</a>, search preview <span class=\"cert c-lo\" title=\"Certainty\">75%</span>. Heinrich, Northeastern Naturalist; Shipley and others 2019, search preview <span class=\"cert c-lo\" title=\"Certainty\">70%</span>.</li><li><a href=\"https://idfg.idaho.gov/press/field-forest-grouse\" target=\"_blank\" rel=\"noopener\">Idaho Fish and Game, Field and forest grouse</a>, read directly <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li><li>Guglielmo and Karasov 1995, Journal of Wildlife Management, abstract via search <span class=\"cert c-mid\" title=\"Certainty\">80%</span>.</li><li>Pendergast and Boag 1973, The Condor, via summaries, search preview <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li><li><a href=\"https://northernwoodlands.org/outside_story/article/why-ruffed-grouse-take-winter-in-stride\" target=\"_blank\" rel=\"noopener\">Northern Woodlands, Why ruffed grouse take winter in stride</a>, search preview <span class=\"cert c-lo\" title=\"Certainty\">60%</span>.</li><li>White and dark muscle in turkeys and chickens, extension and science articles, search preview <span class=\"cert c-lo\" title=\"Certainty\">70%</span>.</li><li>Ruffed grouse survival: University of Maine thesis, Maryland DNR report, Appalachian Wildlife Monograph, search previews <span class=\"cert c-lo\" title=\"Certainty\">75%</span>.</li><li>All checked 2026-10-11. Full log: <code>research/2026-10-11-masterclass-grouse.md</code>.</li></ul></details>"]