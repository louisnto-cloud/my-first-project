4a4136\" stroke-width=\"4.4\" stroke-linecap=\"round\"/><path d=\"M-7 -34 C-7 -38 7 -38 7 -34 L6 -15 H-6z\" fill=\"#e8590c\"/><circle cx=\"0\" cy=\"-41\" r=\"5\" fill=\"#e0b48c\"/><path d=\"M-5.5 -43 C-5.5 -49 5.5 -49 5.5 -43z\" fill=\"#e8590c\"/><path d=\"M6 -22 L9 -62\" stroke=\"#3b2a1a\" stroke-width=\"3\" stroke-linecap=\"round\"/><path d=\"M4 -30 L8 -24\" stroke=\"#e0b48c\" stroke-width=\"3\" stroke-linecap=\"round\"/></g><text x=\"272\" y=\"255\" font-size=\"15\" font-weight=\"bold\" fill=\"#c2410c\">New hunter</text>\n<g transform=\"translate(256 288) scale(.55)\"><path d=\"M-4 -16 L-7 0 M3 -16 L7 0\" stroke=\"#4a4136\" stroke-width=\"4.4\" stroke-linecap=\"round\"/><path d=\"M-7 -34 C-7 -38 7 -38 7 -34 L6 -15 H-6z\" fill=\"#4f5d3c\"/><circle cx=\"0\" cy=\"-41\" r=\"5\" fill=\"#e0b48c\"/><path d=\"M-5.5 -43 C-5.5 -49 5.5 -49 5.5 -43z\" fill=\"#e8590c\"/></g><text x=\"272\" y=\"283\" font-size=\"15\" font-weight=\"bold\" fill=\"#2f3a2b\">Mentor</text>\n<g opacity=\"0\"><set attributeName=\"opacity\" to=\"1\" begin=\"3s\" fill=\"freeze\"/><rect x=\"12\" y=\"44\" width=\"207\" height=\"30\" rx=\"15\" fill=\"#fffaf0\" stroke=\"#2f3a2b\" stroke-width=\"1.5\"/><text x=\"115.719\" y=\"64\" font-size=\"15\" font-weight=\"bold\" fill=\"#2f3a2b\" text-anchor=\"middle\">Mentor sees the muzzle</text></g>\n<g opacity=\"0\"><set attributeName=\"opacity\" to=\"1\" begin=\"5.5s\" fill=\"freeze\"/><rect x=\"12\" y=\"80\" width=\"222\" height=\"30\" rx=\"15\" fill=\"#fffaf0\" stroke=\"#e8590c\" stroke-width=\"1.5\"/><text x=\"122.942\" y=\"100\" font-size=\"15\" font-weight=\"bold\" fill=\"#c2410c\" text-anchor=\"middle\">Mentor says when to load</text></g>\n<g opacity=\"0\"><set attributeName=\"opacity\" to=\"1\" begin=\"8s\" fill=\"freeze\"/><rect x=\"12\" y=\"116\" width=\"269\" height=\"30\" rx=\"15\" fill=\"#2f3a2b\" stroke=\"#2f3a2b\" stroke-width=\"1.5\"/><text x=\"146.375\" y=\"136\" font-size=\"15\" font-weight=\"bold\" fill=\"#fffaf0\" text-anchor=\"middle\">Unload at every fence and creek</text></g>\n</svg>\n<figcaption>New hunter in front, where you can see the muzzle. <button class=\"anim-replay\">↻ Replay</button></figcaption></figure><ul><li>The mentor decides when the firearm is loaded (Tip).</li><li>No loaded firearm in or on a vehicle (99%, synopsis page 11).</li></ul><details class=\"more\"><summary>More: the full safety list</summary><ul><li>Before the first hunt, a range day: <button class=\"term\" data-term=\"ACTS\">ACTS</button> and <button class=\"term\" data-term=\"PROVE\">PROVE</button> until it is automatic (Tip).</li><li>Rule one on the day: the mentor controls when the firearm is loaded (Tip).</li><li>Walk single file, new hunter in front where you can see the muzzle (Tip).</li><li>Agree <button class=\"term\" data-term=\"Zone of fire\">Zone of fire</button> before every setup, out loud (Tip).</li><li>Unloaded at every fence, vehicle and creek crossing (Tip). No loaded firearm in or on a vehicle (99%, synopsis page 11).</li><li>Blaze orange on both of you for the walk in and out (Tip).</li></ul></details>","<figure class=\"diagram\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 430\" font-family=\"sans-serif\" role=\"img\" aria-label=\"What a good mentor does. Do: plan a short first day, warm, fed, home early. Do: explain why, about wind, glassing and shot angle. Do: back every no shot decision. Do: hand them the knife at the gut pile and stay beside them. Do: share the meat and the credit. Do: call a week later and invite them again. Do not: take three new hunters at once, the limit is two. Do not: a 12 hour cold first day with no explanations.\">\n<rect x=\"0\" y=\"0\" width=\"400\" height=\"430\" fill=\"#fffaf0\"/>\n<text x=\"200.0\" y=\"26\" font-size=\"18\" font-weight=\"bold\" fill=\"#23261f\" text-anchor=\"middle\">A good mentor (Tip)</text><rect x=\"10\" y=\"44\" width=\"185\" height=\"88\" rx=\"10\" fill=\"#f3f6ec\" stroke=\"#8a9a6b\" stroke-width=\"2\"/><g transform=\"translate(40 78) 