# ============================================================================
#  SECRETS TEMPLATE  --  copy this file to ".env" and fill in your real values
# ============================================================================
#  How:   cp .env.example .env       (Mac/Linux)
#         copy .env.example .env      (Windows)
#  Then open .env and paste your keys. NEVER share .env or commit it to git.
# ----------------------------------------------------------------------------

# --- Alpaca PAPER keys (fake money). Get them at: https://alpaca.markets ---
# In the Alpaca dashboard, switch to "Paper", open "API Keys", generate a key,
# and copy both values here. The secret is shown only once, so save it now.
ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_key_here

# --- Optional: alert webhook URL (Discord / Slack / ntfy / phone push) ------
# Leave blank to disable alerts. The bot still logs everything to a file.
ALERT_WEBHOOK_URL=

# --- LIVE TRADING SAFETY LATCH ----------------------------------------------
# This MUST be exactly the word "true" before the bot will EVER use real money,
# AND you must also flip the live setting in config.yaml. Leave it unset/false
# while you are paper trading. This is here on purpose to make going live a
# deliberate, two-step decision.
I_UNDERSTAND_THIS_IS_REAL_MONEY=false
